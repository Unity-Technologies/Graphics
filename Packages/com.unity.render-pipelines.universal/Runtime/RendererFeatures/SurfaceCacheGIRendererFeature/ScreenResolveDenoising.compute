#pragma only_renderers d3d11 playstation xboxone xboxseries vulkan metal glcore ps5 switch2

#pragma kernel DenoiseMono DISABLE_TEXTURE2D_X_ARRAY
#pragma kernel DenoiseSinglePassStereoInstancing

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/TextureXR.hlsl"
#include "Packages/com.unity.render-pipelines.core/Runtime/Lighting/SurfaceCache/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/Runtime/Lighting/SurfaceCache/PatchUtil.hlsl"
#include "Packages/com.unity.render-pipelines.core/Runtime/Lighting/SurfaceCache/IrradianceCompression.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Random.hlsl"

TYPED_TEXTURE2D_X(float3, _InputL0);
TYPED_TEXTURE2D_X(float3, _InputL10);
TYPED_TEXTURE2D_X(float3, _InputL11);
TYPED_TEXTURE2D_X(float3, _InputL12);
TYPED_TEXTURE2D_X(float, _LowResNdcDepths);
TYPED_TEXTURE2D_X(float3, _ScreenFlatNormals);

RW_TEXTURE2D_X(float3, _ResultL0);
RW_TEXTURE2D_X(float3, _ResultL10);
RW_TEXTURE2D_X(float3, _ResultL11);
RW_TEXTURE2D_X(float3, _ResultL12);

float4x4 _ClipToWorldTransforms[2];
float3 _CameraWorldPos;
int _PassIndex;

static const uint kKernelStrides[4] = { 1, 2, 2, 3 };

void Denoise(uint2 pixelLowResPos)
{
    uint2 lowResSize;
    GET_TEXTURE2D_X_SIZE(_InputL0, lowResSize.x, lowResSize.y);
    if (any(pixelLowResPos >= lowResSize))
        return;

    uint2 fullResSize;
    GET_TEXTURE2D_X_SIZE(_ScreenFlatNormals, fullResSize.x, fullResSize.y);

    SphericalHarmonics::RGBL1 irradianceSum = (SphericalHarmonics::RGBL1)0;
    PatchUtil::MarkInvalid(irradianceSum);

    const float centerDepth = _LowResNdcDepths[COORD_TEXTURE2D_X(pixelLowResPos)];
    if (centerDepth == invalidNdcDepth)
        return;

    const SphericalHarmonics::RGBL1 centerIrradiance = IrradianceCompression::LoadAndDecompress(
        _InputL0, _InputL10, _InputL11, _InputL12, pixelLowResPos);
    if (!PatchUtil::IsValid(centerIrradiance))
    {
        IrradianceCompression::CompressAndStore(irradianceSum, _ResultL0, _ResultL10, _ResultL11, _ResultL12, pixelLowResPos);
        return;
    }

    const int2 fullResPixelPos = pixelLowResPos * lowResScreenScaling;
    const float2 rcpFullResSize = rcp(float2(fullResSize));
    const float2 centerUv = PixelPosToUvPos(fullResPixelPos, rcpFullResSize);
    const float3 centerWorldPos = ComputeWorldSpacePosition(centerUv, centerDepth, _ClipToWorldTransforms[unity_StereoEyeIndex]);
    const float3 centerWorldNormal = _ScreenFlatNormals[COORD_TEXTURE2D_X(fullResPixelPos)];

    // Hand-picked kernel strides to avoid ringing.
    const uint kernelStride = kKernelStrides[_PassIndex];

    // -log(0.5) / 0.01^2, chosen empirically. Geometric interpretation:
    // At a distance of N from the camera, the falloff rate of the plane distance
    // weight is such that it has half weight (0.5) at a distance N/100.
    const float k_PlaneDistanceFalloff = 0.6931472f / (0.01f * 0.01f);
    const float3 centerToCamera = _CameraWorldPos - centerWorldPos;
    const float planeDistanceFalloff = k_PlaneDistanceFalloff * rcp(dot(centerToCamera, centerToCamera));

    irradianceSum = centerIrradiance;
    float weightSum = 1.0f;

    for (int dy = -1; dy <= 1; ++dy)
    for (int dx = -1; dx <= 1; ++dx)
    {
        if (dx == 0 && dy == 0)
            continue;

        const int2 deltaPixel = (int2(dx, dy) * kernelStride);
        const int2 neighborLowResPos = int2(pixelLowResPos) + deltaPixel;
        if (any(neighborLowResPos < 0) || any(uint2(neighborLowResPos) >= lowResSize))
            continue;

        const float neighborDepth = _LowResNdcDepths[COORD_TEXTURE2D_X(neighborLowResPos)];
        if (neighborDepth == invalidNdcDepth)
            continue;

        const SphericalHarmonics::RGBL1 neighborIrradiance = IrradianceCompression::LoadAndDecompress(
            _InputL0, _InputL10, _InputL11, _InputL12, neighborLowResPos);
        if (!PatchUtil::IsValid(neighborIrradiance))
            continue;

        const int2 neighborFullResPos = neighborLowResPos * lowResScreenScaling;
        const float2 neighborUv = PixelPosToUvPos(neighborFullResPos, rcpFullResSize);
        const float3 neighborWorldPos = ComputeWorldSpacePosition(neighborUv, neighborDepth, _ClipToWorldTransforms[unity_StereoEyeIndex]);
        const float3 neighborNormal = _ScreenFlatNormals[COORD_TEXTURE2D_X(neighborFullResPos)];

        // Gaussian kernel weight.
        const float k_GaussianTightness = 0.6931472f; // -log(0.5), chosen empirically
        const float squaredDistanceToCenter = dot(float2(dx, dy), float2(dx, dy));
        float weight = exp(-squaredDistanceToCenter * k_GaussianTightness);

        // Normal distance weight.
        const float k_NormalWeightExponent = 8;
        weight *= pow(max(0.0f, dot(centerWorldNormal, neighborNormal)), k_NormalWeightExponent);

        // Plane distance weight.
        const float planeDistance = dot(centerWorldNormal, neighborWorldPos - centerWorldPos);
        weight *= exp(-(planeDistance*planeDistance) * planeDistanceFalloff);

        weightSum += weight;
        SphericalHarmonics::MulAddMut(irradianceSum, weight, neighborIrradiance);
    }

    SphericalHarmonics::RGBL1 output = (SphericalHarmonics::RGBL1)0;
    if (weightSum > 0.0f)
        output = SphericalHarmonics::MulPure(irradianceSum, rcp(weightSum));
    else
        PatchUtil::MarkInvalid(output);
    IrradianceCompression::CompressAndStore(output, _ResultL0, _ResultL10, _ResultL11, _ResultL12, pixelLowResPos);
}

[numthreads(8, 8, 1)]
void DenoiseMono(uint2 pixelLowResPos : SV_DispatchThreadID)
{
    Denoise(pixelLowResPos);
}

[numthreads(8, 8, 1)]
void DenoiseSinglePassStereoInstancing(uint3 pixelLowResPos : SV_DispatchThreadID)
{
    UNITY_XR_ASSIGN_VIEW_INDEX(pixelLowResPos.z);
    Denoise(pixelLowResPos.xy);
}

