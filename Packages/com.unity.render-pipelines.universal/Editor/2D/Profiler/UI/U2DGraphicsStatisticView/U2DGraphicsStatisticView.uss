.root-container {
    padding: 10px;
    flex-grow: 1;
    background-color: var(--unity-colors-window-background);
}

.title {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.section-header {
    -unity-font-style: bold;
    margin-top: 5px;
    margin-bottom: 5px;
    padding: 5px;
    background-color: rgba(100, 100, 100, 0.2);
}

.live-toggle {
    margin-bottom: 10px;
    padding: 5px;
}

.counter-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 5px 10px;
    margin: 2px 0;
    background-color: var(--unity-colors-alternated_rows-background);
}

.counter-label {
    font-size: 12px;
    flex: 1 1 0;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    text-overflow: ellipsis;
    overflow: hidden;
}

.counter-value {
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}
